# TrustCatalog environment configuration template.
# Copy this file to `.env` and fill in real values for YOUR machine.
# NEVER commit a real `.env` file - it is already listed in .gitignore.
#
# This DEMO/PROTOTYPE currently reads its configuration from config.py,
# not from these variables directly - they are provided so the project has
# a conventional place to put secrets as it grows toward the PostgreSQL /
# production path described in DEPLOYMENT.md. Wiring config.py to read
# from os.environ is a small, mechanical follow-up (see ARCHITECTURE.md,
# "Production database path").

# --- Database ---------------------------------------------------------
# Local prototype: SQLite, no value needed (see config.py: DB_PATH).
# Production path: a PostgreSQL connection string, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/trustcatalog

# --- Application secrets -----------------------------------------------
# Generate a real value with:  python -c "import secrets; print(secrets.token_hex(32))"
# Used for session/cookie signing if the app moves off Streamlit's own
# session state to a framework that needs one. Not currently read.
SECRET_KEY=change-me-to-a-random-64-character-hex-string

ENVIRONMENT=development
